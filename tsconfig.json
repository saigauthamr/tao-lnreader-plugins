{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "CommonJS",
    "moduleResolution": "node10",
    "paths": {
      "@/*": ["./src/*"],
      "@libs/filterInputs": ["./src/types/filters.ts"],
      "@libs/defaultCover": ["./src/types/constants.ts"],
      "@libs/novelStatus": ["./src/types/constants.ts"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["plugins/**/*.ts", "types/**/*.d.ts"]
}
